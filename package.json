{
  "name": "dsh-duanju-slice",
  "version": "0.3.5",
  "description": "短剧切片工作台：支持跨集卡点混剪与单集连续切片，交付 MP4 和剪映草稿。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "short-drama",
    "duanju",
    "jianying",
    "beat-sync",
    "video-editing"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "lib/{studio,report,drama-source,script,docx,zip,asr,asr-credentials,locate,websocket,release-update}.js",
    "lib/{contiguous,plan,pick,model,frames,slice-draft,draft-root,render,ending,audio,revision}.js",
    "lib/promo/",
    "skills/duanju-slice-runtime/",
    "scripts/survey.mjs",
    "advanced/**/*.py",
    "advanced/**/*.md",
    "assets/ending/",
    "licenses/",
    "cordis.patch.yml",
    "tests/{promo-advanced,promo-asr,promo-subtitles,studio,tools,tool-config,drama-source,support,support-asr,client-render,runtime-download,contiguous,asr-credentials,release-update}.*",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/drama-source.test.mjs tests/studio.test.mjs tests/tools.test.mjs tests/tool-config.test.mjs tests/promo-asr.test.mjs tests/promo-subtitles.test.mjs tests/promo-advanced.test.mjs tests/runtime-download.test.mjs tests/contiguous.test.mjs tests/asr-credentials.test.mjs tests/release-update.test.mjs",
    "survey": "node scripts/survey.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./assets/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
